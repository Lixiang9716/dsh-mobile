# Generated iOS artifacts — never edit by hand.
#
# hosts/ios/App/Generated/** is the runtime/dsh JS bundle embedded as C
# byte arrays, and hosts/ios/DSHSpike.xcodeproj/** is regenerated from
# project.yml by xcodegen — both produced by hosts/ios/gen.sh (committed
# for D9 self-containment; a D9 amendment proposal lands alongside).
#
# Marking them generated collapses PR diffs to a single line and moves
# review to the JS diff — the sources gen.sh embeds are the only place a
# change should start.
#
# `binary` is git's built-in macro (= -diff -merge -text): with diff unset,
# `git diff` renders these as "Bin" / "binary files differ" instead of the
# 300k-line C byte-array wall. `diff=binary` alone is NOT enough — it names
# a diff driver that does not exist, and git falls back to a textual diff.

hosts/ios/App/Generated/** binary linguist-generated
hosts/ios/DSHSpike.xcodeproj/project.pbxproj linguist-generated
hosts/ios/DSHSpike.xcodeproj/** linguist-generated

# govrail's append-only surprises ledger: concurrent writers union-merge.
.gov/surprises.jsonl merge=union

# AOCI baselines exact raw bytes of its index and governance files, so a
# checkout must be byte-identical on every platform: these always check out
# LF, overriding any autocrlf rewrite. (Scoped to AOCI-managed files only —
# not the repo-wide `* eol=lf` aoci-init writes on greenfield projects.)
aoci.txt text eol=lf
aoci.meta.txt text eol=lf
aoci.code.txt text eol=lf
.aoci/** text eol=lf

# Digest records are content-addressed payloads: a core.autocrlf checkout must
# not hand CRLF bytes to the verifiers that hash-compare them.
*.sha256 -text
