{
 "modes": {
  "all": [
   "self-test",
   "notes",
   "pairing",
   "note-presence",
   "conflict-markers",
   "code-size",
   "logging",
   "doc-crosslinks",
   "archive",
   "task"
  ],
  "quick": [
   "notes"
  ],
  "governance": [
   "self-test",
   "verify-decisions"
  ]
 },
 "defaultMode": "all",
 "concurrency": 4,
 "gates": [
  {
   "id": "self-test",
   "label": "governance rejection cases (the govrail tools' own regression)",
   "command": [
    "gov",
    "self-test"
   ]
  },
  {
   "id": "notes",
   "label": "note format",
   "command": [
    "gov",
    "note",
    "verify"
   ],
   "paths": [
    ".agents/notes/**"
   ]
  },
  {
   "id": "pairing",
   "label": "bilingual pairing (advisory until baselined)",
   "command": [
    "gov",
    "verify",
    "pairing"
   ],
   "allowFailure": true,
   "paths": [
    "docs/**",
    "README*",
    ".gov/pairing.json"
   ]
  },
  {
   "id": "note-presence",
   "label": "non-trivial changes carry an Agent Note (advisory)",
   "command": [
    "gov",
    "note",
    "presence"
   ]
  },
  {
   "id": "conflict-markers",
   "label": "no unresolved conflict markers in changed files (issue #104)",
   "command": [
    "gov",
    "verify-conflict-markers"
   ]
  },
  {
   "id": "code-size",
   "label": "source files <=500 lines, functions <=50 lines, indent <=5 levels",
   "command": [
    "python3",
    "tools/check-size.py"
   ]
  },
  {
   "id": "logging",
   "label": "unified logger only; per-module logger; per-function logs; release silence wired",
   "command": [
    "python3",
    "tools/check-logging.py"
   ]
  },
  {
   "id": "doc-crosslinks",
   "label": "bilingual doc pairs must link to each other (language navigation)",
   "command": [
    "python3",
    "tools/check-crosslinks.py"
   ]
  },
  {
   "id": "archive",
   "label": "archived-notes seal",
   "command": [
    "gov",
    "verify-archive"
   ],
   "paths": [
    ".agents/notes/archived/**"
   ]
  },
  {
   "id": "task",
   "label": "task cards",
   "command": [
    "gov",
    "task",
    "check"
   ],
   "paths": [
    ".gov/tasks/**"
   ]
  },
  {
   "id": "verify-decisions",
   "label": "decisions table guard (numbering, alternatives)",
   "command": [
    "gov",
    "verify-decisions"
   ],
   "paths": [
    "docs/decisions.md"
   ]
  }
 ]
}
