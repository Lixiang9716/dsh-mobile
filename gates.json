{
  "modes": {
    "all": [
      "self-test",
      "notes",
      "pairing",
      "note-presence",
      "conflict-markers",
      "check",
      "code-size",
      "logging",
      "doc-crosslinks",
      "archive",
      "task",
      "plane",
      "panel-tests",
      "e2e-matrix",
      "closures",
      "vendoring-repro",
      "bundle-files",
      "webclient-staged-tree",
      "quickjs-boot-parse",
      "staging-check",
      "coverage-floor",
      "asset-mirrors",
      "shellcheck-warn",
      "actionlint",
      "perf-budget"
    ],
    "quick": [
      "notes"
    ],
    "governance": [
      "self-test",
      "verify-decisions",
      "plane"
    ]
  },
  "defaultMode": "all",
  "concurrency": 4,
  "gates": [
    {
      "id": "self-test",
      "label": "governance rejection cases (the govrail tools' own regression)",
      "command": [
        "gov",
        "self-test"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "notes",
      "label": "note format",
      "command": [
        "gov",
        "note",
        "verify"
      ],
      "paths": [
        ".agents/notes/**"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "pairing",
      "label": "bilingual pairing (advisory until baselined)",
      "command": [
        "gov",
        "verify",
        "pairing"
      ],
      "allowFailure": true,
      "stages": [
        "pre-commit"
      ],
      "paths": [
        "docs/**",
        "README*",
        ".gov/pairing.json"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "note-presence",
      "label": "non-trivial changes carry an Agent Note (advisory)",
      "command": [
        "gov",
        "note",
        "presence"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "conflict-markers",
      "label": "no unresolved conflict markers in changed files (issue #104)",
      "command": [
        "gov",
        "verify",
        "conflict-markers"
      ],
      "stages": [
        "pre-commit"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "check",
      "label": "syntax-class static checks over product code (shipped + .gov/checks/ rules)",
      "command": [
        "gov",
        "check"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "code-size",
      "label": "source files <=500 lines, functions <=50 lines, indent <=5 levels",
      "command": [
        "python3",
        "tools/check-size.py"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "logging",
      "label": "unified logger only; per-module logger; per-function logs; release silence wired",
      "command": [
        "python3",
        "tools/check-logging.py"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "doc-crosslinks",
      "label": "bilingual doc pairs must link to each other (language navigation)",
      "command": [
        "python3",
        "tools/check-crosslinks.py"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "archive",
      "label": "archived-notes seal",
      "command": [
        "gov",
        "note",
        "archive-verify"
      ],
      "paths": [
        ".agents/notes/archived/**"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "task",
      "label": "task cards",
      "command": [
        "gov",
        "task",
        "check"
      ],
      "paths": [
        ".gov/tasks/**"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "verify-decisions",
      "label": "decisions table guard (numbering, alternatives)",
      "command": [
        "gov",
        "decision",
        "verify"
      ],
      "paths": [
        "docs/decisions.md"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "plane",
      "label": "governance-plane seal (rules + gate set tamper-evidence)",
      "command": [
        "gov",
        "verify-plane"
      ],
      "paths": [
        ".gov/rules.md",
        "gates.json",
        ".gov/pairing.json",
        ".gov/plane-seal.json"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "panel-tests",
      "label": "web-client-v2 panel unit suite (vitest over the page's pure logic)",
      "command": [
        "sh",
        "test/panel/run.sh"
      ],
      "paths": [
        "test/panel/**",
        "presentation/web-client-v2/**"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "e2e-matrix",
      "command": [
        "sh",
        "test/e2e/matrix.sh",
        "--accept-known-gaps"
      ],
      "description": "cross-host E2E evidence matrix: every finding must be an owned row of the known-gaps register",
      "timeoutMs": 300000
    },
    {
      "id": "closures",
      "command": [
        "sh",
        "build/check-closures.sh"
      ],
      "description": "committed host copies of the canonical runtime/dsh closure are byte-identical (android assets, harmony rawfile, ios generated bundle)",
      "needs": [
        "self-test"
      ]
    },
    {
      "id": "vendoring-repro",
      "command": [
        "sh",
        "runtime/dsh/vendor/reproducibility-proof.sh",
        "--gate"
      ],
      "description": "fresh-clone proof: the vendor scripts materialize what they promise under CI's invocation shapes (mirror-first; engine tarballs + npm legs download)",
      "timeoutMs": 480000
    },
    {
      "id": "bundle-files",
      "command": [
        "node",
        "hosts/harmony/ci/check-bundle-files.mjs"
      ],
      "description": "harmony BUNDLE_FILES vs rawfile/dsh cross-check, both directions (#57)",
      "needs": [
        "self-test"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "webclient-staged-tree",
      "command": [
        "sh",
        "tools/check-webclient-staged-tree.sh"
      ],
      "description": "presentation/web-client-v2 holds exactly its shipped files — the whole-tree-staged harmony HAP directory admits no tooling leakage (the #288 CI-only invariant, now a real gate; A12)",
      "needs": [
        "self-test"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "quickjs-boot-parse",
      "command": [
        "sh",
        "runtime/dsh/ci/check-quickjs-boot-parse.sh"
      ],
      "description": "the real boot graph (fs/fs-seeded/buffer/buffer-codecs splits + bridges) compiles under vendored quickjs-ng via the desktop CLI — node --check passing is not QuickJS can parse",
      "needs": [
        "self-test"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "staging-check",
      "command": [
        "node",
        "tools/check-staging.mjs",
        "--json",
        "--block",
        "harmony,android,ios"
      ],
      "description": "staging manifests match the real import graph (check-staging; findings on blocked hosts exit 1)",
      "needs": [
        "self-test"
      ],
      "paths": [
        "hosts/harmony/entry/src/main/ets/pages/Index.ets",
        "hosts/harmony/ci/vendor-official.sh",
        "hosts/android/ci/stage-spine-closure.sh",
        "hosts/ios/Tools/gen_bundle_header.py",
        "tools/check-staging.mjs",
        "tools/check-staging-graph.mjs",
        "tools/check-staging-hosts.mjs",
        "runtime/dsh/scenario/**",
        "runtime/dsh/upstream/**",
        "runtime/dsh/system-plugins/**"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "coverage-floor",
      "command": [
        "sh",
        "tools/test/run-coverage.sh",
        "--check"
      ],
      "description": "per-surface line/branch coverage floors (warn-tier): vitest v8 measurement vs tools/test/coverage-floors.json floors",
      "allowFailure": true,
      "paths": [
        "presentation/lynx-client/**",
        "tools/test/**",
        "tools/check-coverage-floor.mjs"
      ],
      "needs": [
        "self-test"
      ],
      "timeoutMs": 300000
    },
    {
      "id": "asset-mirrors",
      "command": [
        "node",
        "tools/check-asset-mirrors.mjs",
        "--json"
      ],
      "description": "product trees vs host mirrors byte-identical both ways, iOS embedder declaration aligned (check-asset-mirrors; the #286 timeline.js class)",
      "allowFailure": true,
      "paths": [
        "presentation/web-client-v2/**",
        "presentation/web-client-compact/**",
        "hosts/android/app/src/main/assets/dsh/webclient-*/**",
        "hosts/harmony/entry/src/main/resources/rawfile/dsh/webclient/**",
        "hosts/ios/Tools/gen_bundle_header.py",
        "tools/check-asset-mirrors.mjs"
      ],
      "timeoutMs": 120000,
      "needs": [
        "self-test"
      ]
    },
    {
      "id": "shellcheck-warn",
      "label": "shellcheck threshold 0 at warning grade over the CI-reachable shell scripts (#289's zeroed surface)",
      "command": [
        "sh",
        "tools/check-shellcheck-warn.sh"
      ],
      "description": "any warning/error-grade shellcheck finding in the rule-enumerated CI script surface goes red; info/style out of scope by design (#289); skip-loud when the binary is absent (CI asserts it)",
      "paths": [
        "build/**",
        "tools/**",
        "hosts/android/**",
        "hosts/harmony/**",
        "hosts/ios/**",
        "test/e2e/**",
        "test/tools/**",
        "test/panel/**",
        "packages/release/**",
        "deploy/marketplace/**",
        "presentation/**",
        "runtime/dsh/ci/**",
        "runtime/dsh/vendor/**",
        "runtime/dsh/host/**"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "actionlint",
      "label": "actionlint over every .github/workflows/*.yml (run: blocks shell-linted when shellcheck is present)",
      "command": [
        "sh",
        "tools/check-actionlint.sh"
      ],
      "description": "the workflow lint stops being a local ritual (#289 found its last finding that way); skip-loud when the binary is absent, pinned checksum-verified install in gov.yml",
      "paths": [
        ".github/workflows/**",
        "tools/check-actionlint.sh"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "perf-budget",
      "command": [
        "node",
        "tools/check-perf-budget.mjs"
      ],
      "description": "performance trend gate (warn-tier): the committed perf receipts vs baselines/perf-baseline.json budgets",
      "allowFailure": true,
      "paths": [
        "baselines/**",
        "tools/check-perf-budget.mjs",
        "runtime/dsh/scenario/perf-baseline.js",
        "runtime/dsh/scenario/leak-canary.js",
        "runtime/dsh/ci/run-perf-baseline.sh",
        "runtime/dsh/ci/run-leak-canary.sh",
        "runtime/dsh/artifacts/macos-cli-perf-baseline/**",
        "runtime/dsh/artifacts/macos-cli-leak-canary/**",
        "runtime/dsh/host/dsh_runtime_host.c"
      ],
      "needs": [
        "self-test"
      ],
      "timeoutMs": 120000
    }
  ]
}
