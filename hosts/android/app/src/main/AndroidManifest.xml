<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback carrier: any socket (even 127.0.0.1) requires INTERNET, and
         the WebView loads the carrier origin over cleartext loopback only
         (the spike's transport never leaves the device). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The v1.5.0 haptic primitive maps onto the platform vibrator. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The capability plane's microphone face (v1.10.0 candidate): the
         appendix row for `microphone` — a RUNTIME request; the prompt is the
         second consent layer (the gateway grant is the first). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The capability plane's camera family (v1.10.0): the capture burst
         (cameraCapture) frames ride the app's capture scope. Runtime
         request happens at first use (the second consent layer). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The BLE face (the system capability plane, grant family `ble`): the
         proposal appendix's Android row. API 31+ carries the two runtime
         permissions; the legacy pair stays for the API 26-30 floor and is
         capped at 30 so modern installs never see it. neverForLocation:
         scan results feed device connections, never location derivation. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <application
        android:label="DSH Spike Host"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/DshSpikeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- presentShare's content:// staging: serves ONLY the files the
             share primitive already resolved through the fs scope
             discipline, read-only, per-call (ShareFilesProvider.clear on
             completion). grantUriPermissions lets the share target read it. -->
        <provider
            android:name=".ShareFilesProvider"
            android:authorities="com.dshmobile.spike.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
