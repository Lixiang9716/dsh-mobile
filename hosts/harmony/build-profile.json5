/*
 * Project-level build profile for the dsh-mobile M1 spike HAP.
 * Built with the HarmonyOS CLT 26.0.0 flow (see README.md):
 *   DEVECO_SDK_HOME=<clt>/sdk; ohpm install --all; hvigorw assembleHap
 */
{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
        // NO product-level `buildOption.debuggable` here. It was hardcoded
        // `true`, and a product buildOption applies to EVERY buildMode — so
        // the release HAP still packed `debug: true` / `buildMode: debug` in
        // its module.json (the schema's own default for the field is `true`
        // too, so removing the line alone is not enough). The switch now
        // lives per-mode in entry/build-profile.json5's buildOptionSet.
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [ "default" ]
        }
      ]
    }
  ]
}
