/*
 * entry module build profile: stage-model HAP with the native NAPI library
 * (CMake) for the quickjs spike host.
 */
{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "buildOptionSet": [
    {
      // The harness: full structured logging, E2E drives run. It publishes
      // the flavor field as false so the ArkTS import resolves in BOTH modes
      // (an export that exists only in release would make every debug build
      // fail to compile).
      "name": "debug",
      // `debuggable` is declared in BOTH entries on purpose: the field's
      // schema default is `true`, so omitting it in the release entry ships a
      // debuggable release build (which is exactly the bug this pair fixes).
      "debuggable": true,
      "arkOptions": {
        "buildProfileFields": {
          "DSH_RELEASE": false
        }
      }
    },
    {
      "name": "release",
      // The release build is what a user gets, and the define reaches BOTH
      // halves. `arguments` lands as a CMake cache variable (cppFlags maps to
      // CMAKE_CXX_FLAGS only, so it would miss the C host); CMakeLists turns
      // it into a compile definition for the whole spike target, the shared C
      // host then injects globalThis.__DSH_RELEASE__, and the JS logger drops
      // debug/info at the source. `buildProfileFields` publishes the same
      // flag to ArkTS as a generated BuildProfile constant.
      // `externalNativeOptions` is restated IN FULL so the per-mode merge can
      // never drop the module's own `path` (a lost path fails the build loud
      // rather than silently building nothing — rule 5).
      "externalNativeOptions": {
        "path": "./src/main/cpp/CMakeLists.txt",
        "arguments": "-DDSH_RELEASE=1",
        "cppFlags": "",
        "abiFilters": [
          "arm64-v8a"
        ]
      },
      "debuggable": false,
      "arkOptions": {
        "buildProfileFields": {
          "DSH_RELEASE": true
        },
        "obfuscation": {
          // Obfuscation stays OFF, and `files` is deliberately absent: the
          // previous entry pointed at './obfuscation-rules.txt', a file that
          // has never existed in this repository. It went unnoticed because
          // the product-level `debuggable: true` made every build debuggable,
          // and hvigor skips obfuscation for a debuggable build — so the
          // dangling path was never resolved. Turning the build genuinely
          // release-mode is what exposed it. `ruleOptions` requires only
          // `enable` (verified against hvigor's own schema), and obfuscation
          // is disabled, so no rules file is needed.
          "ruleOptions": {
            "enable": false
          }
        }
      }
    }
  ],
  "targets": [
    { "name": "default" }
  ]
}
