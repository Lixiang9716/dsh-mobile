// dsh:logging-exempt (named route: evidence rides the phase sink)
/**
 * WebPlugins — the `/plugins` prefix route, the client-modules bundle surface
 * of docs/webserver-contract.md §2.5, generated by the carrier from the
 * staged plugin set (§3.4: same JSON/URL shapes upstream emits, no upstream
 * code). Serves the revisioned single-resource combo
 * `/plugins/??<id>/client.js&rev=<rev>`, the aggregate
 * `/plugins/??<a>/client.js,<b>/client.js&rev=…` combine form, and the
 * `.map` identity maps; anything else under /plugins is an unknown resource
 * → 404; non-GET/HEAD → 405. Sources come from rawfile
 * (`spike/officialweb/plugins/npm/@deepseek-ai/<pkg>/lib/client.js`).
 *
 * Upstream byte semantics (CarrierPlugins.swift is the platform twin):
 * prepareSource trailer strip, `;\n` per source, combo sourceMappingURL,
 * framedHash combo rev, identity per-line maps.
 */
import { socket } from '@kit.NetworkKit';
import { util } from '@kit.ArkTS';
import { hilog } from '@kit.PerformanceAnalysisKit';
import { sha1Hex } from './Sha1';
import { CarrierRequest, CarrierServer } from './CarrierServer';

const TAG: string = 'dsh.app';
const CACHE_CONTROL = 'public, max-age=31536000, immutable';
const SCRIPT_MIME = 'text/javascript; charset=utf-8';
const MAP_MIME = 'application/json; charset=utf-8';

/** One staged bundle, prepared once at init (upstream `prepareSource`). */
interface Prepared {
  id: string;
  source: string;
  rev: string;
}

export class WebPlugins {
  /** Evidence hook: (resource URL, byte count) per served bundle. */
  onComboServed: (url: string, bytes: number) => void =
    (url: string, bytes: number): void => {};

  private server: CarrierServer;
  private rawfile: (rel: string) => Uint8Array | null;
  /** Staged entries in boot-graph order (deterministic; an array, not a map). */
  private entries: Prepared[] = [];
  private byId: Map<string, number> = new Map();

  constructor(server: CarrierServer, rawfile: (rel: string) => Uint8Array | null,
    packageDirs: string[]) {
    this.server = server;
    this.rawfile = rawfile;
    // Sorted directory order = the delivery order = the graph's scan-order
    // tie-break (the same staging contract the iOS drive pins).
    const dirs = packageDirs.slice().sort();
    for (let i = 0; i < dirs.length; i++) {
      const dirName = dirs[i];
      const at = dirName.lastIndexOf('@');
      if (at <= 0) {
        continue;
      }
      const id = '@deepseek-ai/' + dirName.substring(0, at);
      const raw = rawfile('officialweb/plugins/npm/@deepseek-ai/' + dirName +
        '/lib/client.js');
      if (raw === null) {
        continue;
      }
      const source = WebPlugins.prepareSource(WebPlugins.text(raw));
      const index = this.entries.length;
      this.entries.push({ id: id, source: source,
        rev: WebPlugins.shortHash(source) });
      this.byId.set(id, index);
    }
    hilog.info(0x0000, TAG, 'plugins route: %{public}d staged entries',
      this.entries.length);
  }

  handler = (req: CarrierRequest, conn: socket.TCPSocketConnection): void => {
    this.serve(req, conn);
  };

  /** The boot-graph rows this staged set yields while the runtime boots
   * (upstream `WebBootEntry`); replaced by `applyRuntimeRevs` once the
   * runtime's `web.boot` arrives. */
  bootEntries(): Array<Record<string, string>> {
    const rows: Array<Record<string, string>> = [];
    for (let i = 0; i < this.entries.length; i++) {
      const row: Record<string, string> = {
        'id': this.entries[i].id,
        'url': WebPlugins.entryURL(this.entries[i].id, this.entries[i].rev),
        'rev': this.entries[i].rev,
      };
      rows.push(row);
    }
    return rows;
  }

  /** Adopts the RUNTIME's graph rows (`web.boot`): the staged content hashes
   * are placeholders, so the route must serve and validate against the
   * runtime's revs. Unknown ids are ignored (the carrier serves only what it
   * stages — fail loud upstream if the graph disagrees). */
  applyRuntimeRevs(rows: Array<Record<string, string>>): void {
    for (let i = 0; i < rows.length; i++) {
      const id = rows[i]['id'];
      const rev = rows[i]['rev'];
      if (id === undefined || rev === undefined) {
        continue;
      }
      const at = this.byId.get(id);
      if (at !== undefined) {
        this.entries[at].rev = rev;
      }
    }
  }

  // ---- request handling -----------------------------------------------------

  private serve(req: CarrierRequest, conn: socket.TCPSocketConnection): void {
    if (req.method !== 'GET' && req.method !== 'HEAD') {
      this.respond(conn, 405, '', 'text/plain', false);
      return;
    }
    if ((req.query ?? '').startsWith('?') &&
      (req.rawPath === '/plugins' || req.rawPath === '/plugins/')) {
      this.serveCombo(req, conn);
      return;
    }
    this.serveSingle(req, conn);
  }

  /** The combine form: `??<id>/client.js(,<id>/client.js)*&rev=<rev>`
   * (upstream `buildComboScript`: each prepared source is followed by
   * `;\n`, then the combo's own sourceMappingURL line). The `??` target
   * splits at the FIRST `?`, so the query still carries the second `?` —
   * strip it (the iOS carrier's `dropFirst`) before parsing resources. */
  private serveCombo(req: CarrierRequest, conn: socket.TCPSocketConnection): void {
    const query = (req.query ?? '').substring(1);
    const body = this.comboBody(query);
    if (body === null) {
      this.respond(conn, 404, '', 'text/plain', false);
      return;
    }
    this.onComboServed('/plugins/??' + query, WebPlugins.utf8Count(body));
    this.respond(conn, 200, body, SCRIPT_MIME, req.method === 'HEAD');
  }

  /** Single-resource forms: `/plugins/<id>/client.js?rev=` (a one-entry
   * combo) and `/plugins/<id>/client.js.map?rev=` (identity map). */
  private serveSingle(req: CarrierRequest, conn: socket.TCPSocketConnection): void {
    const pieces = req.path === null ? [] : req.path.split('/').filter(
      (p: string): boolean => p.length > 0);
    if (pieces.length !== 3 || pieces[0] !== 'plugins') {
      this.respond(conn, 404, '', 'text/plain', false);
      return;
    }
    const at = this.byId.get(pieces[1] /* id */);
    if (at === undefined) {
      this.respond(conn, 404, '', 'text/plain', false);
      return;
    }
    const entry = this.entries[at];
    if (req.query !== 'rev=' + entry.rev) {
      this.respond(conn, 404, '', 'text/plain', false);
      return;
    }
    if (pieces[2] /* file */ === 'client.js') {
      const mapURL = '/plugins/??' + entry.id +
        '/client.js.map&rev=' + entry.rev;
      const body = entry.source + ';\n//# sourceMappingURL=' + mapURL + '\n';
      this.onComboServed('/plugins/??' + entry.id + '/client.js&rev=' + entry.rev,
        WebPlugins.utf8Count(body));
      this.respond(conn, 200, body, SCRIPT_MIME, req.method === 'HEAD');
      return;
    }
    if (pieces[2] === 'client.js.map') {
      const map = WebPlugins.identityMap(entry.source,
        '/plugins/' + entry.id + '/client.js', 'client.js');
      this.respond(conn, 200, map, MAP_MIME, req.method === 'HEAD');
      return;
    }
    this.respond(conn, 404, '', 'text/plain', false);
  }

  /** Builds the combo body when every listed `<id>/client.js` is staged and
   * the declared rev matches the ordered combo rev; null otherwise (404). */
  private comboBody(query: string): string | null {
    const at = query.indexOf('&rev=');
    if (at < 0) {
      return null;
    }
    const resources = query.substring(0, at).split(',');
    const rev = query.substring(at + 5);
    if (resources.length === 0 || resources[0] === '') {
      return null;
    }
    const indexes: number[] = [];
    const ids: string[] = [];
    for (let i = 0; i < resources.length; i++) {
      if (!resources[i].endsWith('/client.js')) {
        return null;
      }
      const id = resources[i].substring(0, resources[i].length - '/client.js'.length);
      const index = this.byId.get(id);
      if (index === undefined) {
        return null;
      }
      indexes.push(index);
      ids.push(id);
    }
    const revs = indexes.map((index: number): string => this.entries[index].rev);
    const comboRev = WebPlugins.comboRev(ids, revs);
    if (comboRev !== rev) {
      return null;
    }
    let body = '';
    for (let i = 0; i < indexes.length; i++) {
      body += this.entries[indexes[i]].source + ';\n';
    }
    const mapResources = ids.map((id: string): string => id + '/client.js.map')
      .join(',');
    body += '//# sourceMappingURL=/plugins/??' + mapResources +
      '&rev=' + comboRev + '\n';
    return body;
  }

  private respond(conn: socket.TCPSocketConnection, status: number, body: string,
    mime: string, bodyless: boolean): void {
    const extra: Record<string, string> = {};
    if (status === 200) {
      extra['Cache-Control'] = CACHE_CONTROL;
    }
    this.server.respond(conn, status, mime, WebPlugins.textBytes(body), extra,
      bodyless);
  }

  // ---- upstream byte semantics ------------------------------------------------

  /** Strips bundle-local debug trailers and keeps a trailing newline
   * (upstream `prepareSource`). */
  static prepareSource(raw: string): string {
    const lines = raw.split('\n');
    while (lines.length > 0) {
      let last = lines[lines.length - 1];
      if (last.endsWith('\r')) {
        last = last.substring(0, last.length - 1);
      }
      if (last.startsWith('//# sourceMappingURL=') ||
        last.startsWith('//# sourceURL=')) {
        lines.pop();
        continue;
      }
      break;
    }
    let source = lines.join('\n');
    if (source.length > 0 && !source.endsWith('\n')) {
      source += '\n';
    }
    return source;
  }

  /** sha1 content hash shortened to 12 hex chars (upstream `shortHash`),
   * over the hand-rolled SHA-1 of model/Sha1.ets. */
  static shortHash(input: string): string {
    const encoder = util.TextEncoder.create('utf-8');
    return sha112(encoder.encodeInto(input));
  }

  /** Upstream `framedHash`: length-prefixed parts so bytes cannot move
   * across field boundaries. */
  static comboRev(ids: string[], revs: string[]): string {
    const encoder = util.TextEncoder.create('utf-8');
    let bytes = encoder.encodeInto('combo\0');
    for (let i = 0; i < ids.length; i++) {
      bytes = concat(bytes, encoder.encodeInto(ids[i].length + ':'));
      bytes = concat(bytes, encoder.encodeInto(ids[i]));
      bytes = concat(bytes, encoder.encodeInto(revs[i].length + ':'));
      bytes = concat(bytes, encoder.encodeInto(revs[i]));
    }
    return sha112(bytes);
  }

  /** Identity per-line map for one generated source (upstream
   * `identitySectionMap`), wrapped in the combo indexed-map form. */
  static identityMap(source: string, sourceURL: string, file: string): string {
    const lines = source.split('\n').length;
    const mappings: string[] = [];
    for (let i = 0; i < Math.max(lines, 1); i++) {
      mappings.push(i === 0 ? 'AAAA' : 'AACA');
    }
    const sources: string[] = [sourceURL];
    const sourcesContent: string[] = [source];
    const section: Record<string, Object> = {
      'version': 3,
      'names': [],
      'sources': sources,
      'sourcesContent': sourcesContent,
      'mappings': mappings.join(';'),
    };
    const offset: Record<string, number> = { 'line': 0, 'column': 0 };
    const sections: Array<Record<string, Object>> = [];
    const entry: Record<string, Object> = {};
    entry['offset'] = offset;
    entry['map'] = section;
    sections.push(entry);
    const wrapped: Record<string, Object> = {
      'version': 3,
      'file': file,
      'sections': sections,
    };
    let json = JSON.stringify(wrapped);
    json = json.split('<').join('\\u003c');
    return json + '\n';
  }

  /** Boot-graph entry URL: the revisioned single-resource combo form. */
  static entryURL(id: string, rev: string): string {
    return '/plugins/??' + id + '/client.js&rev=' + rev;
  }

  static text(bytes: Uint8Array): string {
    const decoder = util.TextDecoder.create('utf-8');
    return decoder.decodeToString(bytes);
  }

  static textBytes(text: string): ArrayBuffer {
    if (text.length === 0) {
      return new ArrayBuffer(0); // encodeInto('') returns undefined on this SDK
    }
    const encoder = util.TextEncoder.create('utf-8');
    const bytes = encoder.encodeInto(text);
    return bytes.buffer.slice(bytes.byteOffset,
      bytes.byteOffset + bytes.byteLength) as ArrayBuffer;
  }

  static utf8Count(text: string): number {
    return WebPlugins.textBytes(text).byteLength;
  }
}

function concat(a: Uint8Array, b: Uint8Array): Uint8Array {
  const out = new Uint8Array(a.length + b.length);
  out.set(a);
  out.set(b, a.length);
  return out;
}

function sha112(bytes: Uint8Array): string {
  // The content digest rides the hand-rolled SHA-1 of model/Sha1.ets,
  // shortened to 12 hex chars (upstream `shortHash`).
  return sha1Hex(bytes).substring(0, 12);
}
