{
  "scenario": "ish.shell",
  "extract": { "prefix": "dsh.spike.log:" },
  "expect": [
    { "event": "plugin", "match": { "name": "dsh-shell-ish", "tool": "ish" } },
    { "event": "guest.machine", "match": { "command": "uname -m", "exitCode": 0, "stdout": "aarch64\n" } },
    { "event": "guest.release", "match": { "command": "cat /etc/alpine-release", "exitCode": 0, "stdout": "3.21.8\n" } },
    { "event": "guest.user", "match": { "command": "id -un", "exitCode": 0, "stdout": "root\n" } },
    { "event": "guest.wrote", "match": { "exitCode": 0 } },
    { "event": "deliverable", "match": { "file": "ish-deliverable.txt", "bytes": 36, "sha256": "7cd0a652c005c4e8432f3670c549dd53cb49e7a3ff8c52a82cdc48183d8d69d8", "text": "deliverable from the emulated guest" } },
    { "event": "guest.stderr", "match": { "exitCode": 7, "stdout": "", "stderr": "expected-on-stderr\n" } },
    { "event": "guest.pipeline", "match": { "command": "printf 'b\\na\\nc\\n' | sort | tr '\\n' '-'", "exitCode": 0, "stdout": "a-b-c-" } },
    { "event": "guest.timeout", "match": { "command": "sleep 30; echo never", "timedOut": true } },
    { "event": "guest.recovered", "match": { "command": "echo still-alive", "exitCode": 0, "stdout": "still-alive\n" } },
    { "event": "scenario.complete", "match": { "commands": 9 } }
  ]
}
