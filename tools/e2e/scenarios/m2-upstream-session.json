{
  "scenario": "m2.upstream-session",
  "extract": {
    "prefix": "dsh.spike.log:"
  },
  "expect": [
    {
      "event": "model/scripted",
      "match": {
        "provider": "scripted",
        "model": "scripted-1",
        "note": "upstream-shape driver; real dsh-llm transport lands with W-LLM vendor"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile",
        "root": "empty (patch layers compose over it)",
        "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
        "layers": [
          "session",
          "agent",
          "system-prompt",
          "tools",
          "session-projection",
          "settings",
          "agent-loop"
        ]
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2",
        "services": [
          "sessions",
          "agents",
          "systemPrompt",
          "tools",
          "sessionProjections",
          "settings",
          "agentLoop",
          "llm"
        ],
        "scripted": [
          "llm"
        ]
      }
    },
    {
      "event": "session/created",
      "match": {
        "sessionId": "s-m2-upstream-0001",
        "observed": true
      }
    },
    {
      "event": "agent/created",
      "match": {
        "id": "main",
        "sessionId": "s-m2-upstream-0001"
      }
    },
    {
      "event": "agent/inbox/spliced",
      "match": {
        "seq": 0
      }
    },
    {
      "event": "turn/start",
      "match": {
        "turn": 1
      }
    },
    {
      "event": "agent/inbox/spliced",
      "match": {
        "seq": 2
      }
    },
    {
      "event": "step/start",
      "match": {
        "turn": 1,
        "step": 1
      }
    },
    {
      "event": "system/message",
      "match": {
        "seq": 4,
        "plugin": "@deepseek-ai/dsh-system-prompt"
      }
    },
    {
      "event": "user/message",
      "match": {
        "seq": 5
      }
    },
    {
      "event": "request/header",
      "match": {
        "seq": 6
      }
    },
    {
      "event": "request/context",
      "match": {
        "seq": 7
      }
    },
    {
      "event": "assistant/message",
      "match": {
        "seq": 8,
        "blocks": [
          "text"
        ],
        "text": "Hello from upstream",
        "provider": "scripted",
        "model": "scripted-1"
      }
    },
    {
      "event": "step/end",
      "match": {
        "turn": 1,
        "step": 1
      }
    },
    {
      "event": "turn/end",
      "match": {
        "turn": 1,
        "reason": "completed"
      }
    },
    {
      "event": "session/log/asserted",
      "match": {
        "count": 11,
        "types": [
          "agent/inbox/spliced",
          "turn/start",
          "agent/inbox/spliced",
          "step/start",
          "system/message",
          "user/message",
          "request/header",
          "request/context",
          "assistant/message",
          "step/end",
          "turn/end"
        ]
      }
    },
    {
      "event": "assistant/text/asserted",
      "match": {
        "text": "Hello from upstream"
      }
    },
    {
      "event": "model/request",
      "match": {
        "provider": "scripted",
        "model": "scripted-1",
        "tools": 0,
        "messages": 2
      }
    },
    {
      "event": "agent/status",
      "match": {
        "status": "running"
      }
    },
    {
      "event": "agent/status",
      "match": {
        "status": "idle"
      }
    },
    {
      "event": "projection/turn-boundary",
      "match": {
        "lastTurn": 1
      }
    },
    {
      "event": "upstream/completed",
      "match": {
        "status": "pass",
        "upstream": "0.1.6-alpha.2",
        "scripted": "model.scripted (dsh-llm transport lands with W-LLM)"
      }
    }
  ]
}
