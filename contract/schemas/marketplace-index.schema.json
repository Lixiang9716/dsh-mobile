{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-mobile.dev/contract/schemas/marketplace-index.schema.json",
  "title": "DSH marketplace signed catalog (schemaVersion 1)",
  "description": "Static signed plugin-catalog index; discovery and install ride the frozen httpFetch primitive. Spec: contract/data-protocols.md §7.",
  "type": "object",
  "required": [
    "schemaVersion",
    "marketplace",
    "generatedAt",
    "keys",
    "entries",
    "signatures"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "marketplace": {
      "const": "dsh",
      "description": "The catalog identity; v0 has exactly one marketplace."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Catalog generation instant (RFC 3339); the authoring CI pins it for reproducible bytes."
    },
    "keys": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "additionalProperties": {
        "$ref": "#/$defs/ed25519Public"
      },
      "description": "The CURRENT verification key set: keyId → ed25519 public key (base64). Hosts pin the initial key out-of-band and learn keys only per §7.2."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "type",
          "tgzUrl",
          "blobSha256",
          "manifestSha256",
          "capabilities",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "minLength": 3,
            "description": "Package identity; matches the package manifest id (schemas/manifest.schema.json)."
          },
          "version": {
            "$ref": "#/$defs/semver"
          },
          "type": {
            "enum": [
              "service",
              "web-client"
            ]
          },
          "tgzUrl": {
            "type": "string",
            "pattern": "^https?://",
            "description": "Where the package tarball is hosted (plain file hosting; fetched over the frozen httpFetch)."
          },
          "blobSha256": {
            "$ref": "#/$defs/sha256"
          },
          "manifestSha256": {
            "$ref": "#/$defs/sha256"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "optional"
            ],
            "properties": {
              "required": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/capability"
                }
              },
              "optional": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/capability"
                }
              }
            },
            "description": "ADVISORY DISPLAY DATA only — the package manifest stays the single source of truth; grants happen at install time (data-protocols.md §2 negotiation)."
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "zh": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "description": "The signing keyId; MUST be a key of the keys map."
          },
          "value": {
            "$ref": "#/$defs/ed25519Signature"
          }
        }
      },
      "description": "One ed25519 signature (PureEdDSA, RFC 8032) over the canonical JSON of everything except this field — two during a rotation window (§7.2)."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "semver 2.0.0."
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9.-]*(@[0-9]+)?$",
      "description": "<name> or <name>@<major>; see contract/data-protocols.md §5."
    },
    "ed25519Public": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$",
      "description": "32-byte ed25519 public key, standard base64 (padded) — the 4-bit tail constrains the last data character."
    },
    "ed25519Signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$",
      "description": "64-byte ed25519 signature, standard base64 (padded) — the 2-bit tail constrains the last data character."
    }
  }
}
