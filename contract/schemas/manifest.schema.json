{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-mobile.dev/contract/schemas/manifest.schema.json",
  "title": "DSH plugin manifest (schemaVersion 1)",
  "description": "Static plugin manifest. Reading it must never execute code. Spec: contract/data-protocols.md §2.",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "type", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "minLength": 3,
      "description": "Package identity, stable across versions, e.g. dsh-fs-ios."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "semver 2.0.0."
    },
    "type": { "enum": ["service", "web-client"] },
    "entry": {
      "type": "string",
      "pattern": "^((?!\\.\\.).)+$",
      "description": "ESM entry relative to bundle/. Required when type=service."
    },
    "web": {
      "type": "string",
      "pattern": "^((?!\\.\\.).)+$",
      "description": "Web Client assets directory relative to the package root. Required when type=web-client."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activate": { "type": "string", "description": "Named export of the entry module." },
        "deactivate": { "type": "string", "description": "Named export of the entry module." }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*(@[0-9]+)?$",
      "description": "<name> or <name>@<major>; see contract/data-protocols.md §5."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "service" } } },
      "then": { "required": ["entry"] }
    },
    {
      "if": { "properties": { "type": { "const": "web-client" } } },
      "then": { "required": ["web"] }
    }
  ]
}
