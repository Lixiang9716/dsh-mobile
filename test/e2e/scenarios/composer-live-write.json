  {
   "event": "client.selected",
   "match": {
    "client": "dsh-web-official",
    "source": "launch"
   }
  },
  {
   "event": "llm/runtime",
   "match": {
    "provider": "mock",
    "model": "mock-1",
    "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
    "transport": "gateway httpFetch \u2192 carrier scripted chat-completions (E2E determinism boundary, mirrors the CLI mock server)",
    "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
   }
  },
  {
   "event": "upstream/profile",
   "match": {
    "profile": "mobile",
    "root": "empty (patch layers compose over it)",
    "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
    "layers": [
     "session",
     "agent",
     "system-prompt",
     "tools",
     "session-projection",
     "settings",
     "agent-loop"
    ]
   }
  },
  {
   "event": "upstream/services",
