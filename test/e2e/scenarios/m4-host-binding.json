{
  "scenario": "m4.host-binding",
  "extract": { "prefix": "dsh.spike.log:" },
  "expect": [
    { "event": "client.selected", "match": { "client": "dsh-web-client" } },
    { "event": "gateway.negotiated", "match": { "version": "gateway@1" } },
    { "event": "descriptor.declared", "match": { "available": 9, "unavailable": 0 } },
    { "event": "carrier.listening", "match": { "transport": "tcp", "loopback": true } },
    { "event": "webclient.mounted", "match": { "client": "dsh-web-client", "path": "/index.html" } },
    { "event": "ws.connected", "match": { "protocol": "session-projection@0" } },
    { "event": "slot.registered", "match": { "id": "m4.toolbar", "label": "host", "by": "m4-host-binding" } },
    { "event": "host.ready", "match": { "signalled": true } },
    { "event": "session.created", "match": { "sessionId": "s-m4-0001", "scope": "app" } },
    { "event": "agent.started", "match": { "model": "mock-mini", "tools": 1 } },
    { "event": "llm.stream.started", "match": { "turn": 1 } },
    { "event": "llm.delta", "match": { "index": 0, "text": "Host" } },
    { "event": "ws.token-delta", "match": { "first": true, "index": 0 } },
    { "event": "llm.delta", "match": { "index": 1, "text": " binding" } },
    { "event": "llm.stream.completed", "match": { "turn": 1, "deltas": 2, "toolCalls": 0 } },
    { "event": "session.completed", "match": { "sessionId": "s-m4-0001", "status": "pass", "deltas": 2, "toolCalls": 0 } },
    { "event": "ws.token-delta", "match": { "first": false, "last": true, "index": 1 } },
    { "event": "ws.session-complete", "match": { "status": "pass" } },
    { "event": "fs.write.ok", "match": { "written": 17 } },
    { "event": "fs.read.ok", "match": { "bytes": 17, "matches": true } },
    { "event": "fs.denied", "match": { "code": "denied" } },
    { "event": "http.status", "match": { "status": 200, "loopback": true } },
    { "event": "http.body", "match": { "chunks": 2, "totalBytes": 64 } },
    { "event": "http.aborted", "match": { "code": "cancelled" } },
    { "event": "picker.granted", "match": { "mode": "directory", "scopeOpaque": true } },
    { "event": "fs.scope.persist", "match": { "refOpaque": true } },
    { "event": "fs.scope.resolve", "match": { "scopeOpaque": true, "reads": true } },
    { "event": "approval.approved", "match": { "approved": true, "remember": false } },
    { "event": "keychain.roundtrip", "match": { "set": true, "match": true } },
    { "event": "keychain.deleted", "match": { "gone": true } },
    { "event": "notify.scheduled", "match": { "idOpaque": true } },
    { "event": "app.state", "match": { "state": "background" } },
    { "event": "notify.response", "match": { "idMatches": true } },
    { "event": "app.state", "match": { "state": "foreground" } },
    { "event": "scenario.complete", "match": { "status": "pass" } }
  ]
}
