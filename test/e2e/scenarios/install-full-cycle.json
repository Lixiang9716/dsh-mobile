{
  "scenario": "install.full-cycle",
  "extract": { "prefix": "dsh.spike.log:" },
  "expect": [
    { "event": "gateway.negotiated", "match": { "version": "gateway@1" } },
    { "event": "config.layer", "match": { "layer": "base", "keys": ["webClient", "slots"] } },
    { "event": "config.layer", "match": { "layer": "profile", "keys": ["webClient", "slots"] } },
    { "event": "config.resolved", "match": { "webClient": "dsh-web-client-mini", "slots": ["notes.toolbar"], "format": "cordis.patch.json" } },
    { "event": "config.slot.allowed", "match": { "id": "notes.toolbar" } },
    { "event": "config.slot.denied", "match": { "id": "debug.console", "allow": ["notes.toolbar"] } },
    { "event": "fs.ready", "match": { "service": "fs" } },
    { "event": "fixture.built", "match": { "members": 2, "bytes": 3584 } },
    { "event": "install.fetch.stub", "match": { "via": "scope-read", "path": "packages/dsh-notes-0.1.0.tar", "chunks": 7 } },
    { "event": "install.fetch.start", "match": { "url": "scope://app/packages/dsh-notes-0.1.0.tar" } },
    { "event": "install.fetch.status", "match": { "status": 200 } },
    { "event": "install.fetch.body", "match": { "chunks": 7, "bytes": 3584 } },
    { "event": "install.blob.stored", "match": { "sha256": "eb478c292d671deac3617f2759a0a44293cbf292b17b0233677aa3a871b4dd56", "bytes": 3584 } },
    { "event": "install.digest.verified", "match": { "sha256": "eb478c292d671deac3617f2759a0a44293cbf292b17b0233677aa3a871b4dd56" } },
    { "event": "install.manifest.validated", "match": { "id": "dsh-notes", "version": "0.1.0" } },
    { "event": "install.integrity.computed", "match": { "files": 2, "manifestSha256": "26d16425d35d55800325345d53375ace7a9f8f1d3f794fb5b71ae62d6ae99358" } },
    { "event": "install.negotiated", "match": { "required": 2, "skipped": false } },
    { "event": "install.receipt.pending", "match": { "txId": "m3-c001", "journal": "receipts/journal.jsonl" } },
    { "event": "install.staged.verified", "match": { "files": 3 } },
    { "event": "install.promoted", "match": { "dir": "plugins/dsh-notes@0.1.0", "files": 3 } },
    { "event": "install.committed", "match": { "status": "committed", "previousVersion": null, "treeSha256": "a7c1a54bab6caa41055a0d7b4086d6e41ecf7cb74c846490304d87ddeda51a4d" } },
    { "event": "install.receipt.asserted", "match": { "status": "committed", "id": "dsh-notes", "version": "0.1.0", "blobSha256": "eb478c292d671deac3617f2759a0a44293cbf292b17b0233677aa3a871b4dd56", "journalLines": 2 } },
    { "event": "installed.loaded", "match": { "id": "dsh-notes", "moduleId": "plugins/dsh-notes@0.1.0/bundle/index.js" } },
    { "event": "notes.write.ok", "match": { "path": "install-verified-tarball/notes/first.txt", "written": 20 } },
    { "event": "notes.read.ok", "match": { "text": "hello from dsh-notes" } },
    { "event": "install.badge.built", "match": { "bytes": 3584 } },
    { "event": "install.blob.stored", "match": { "sha256": "1e91e91fdee0e67f8e8521476b04d54ca48bd2b364ee9ca8b19043925a48fbac", "bytes": 3584 } },
    { "event": "install.digest.verified", "match": { "sha256": "1e91e91fdee0e67f8e8521476b04d54ca48bd2b364ee9ca8b19043925a48fbac" } },
    { "event": "install.manifest.validated", "match": { "id": "dsh-badge", "version": "0.1.0" } },
    { "event": "install.integrity.computed", "match": { "files": 2, "manifestSha256": "cb595948bac5b1ce0dc661fd905fd690892e572a79f7b6cd4ba2e3d1caed2c4e" } },
    { "event": "install.capability-rejected", "match": { "missing": ["notify"], "required": 3 } },
    { "event": "install.tree.intact", "match": { "verified": true } },
    { "event": "crash.simulated", "match": { "txId": "m3-c004", "mode": "staged-verifies", "files": 2 } },
    { "event": "crash.simulated", "match": { "txId": "m3-c005", "mode": "staging-incomplete", "files": 1 } },
    { "event": "replay.begin", "match": { "pending": 2 } },
    { "event": "replay.committed", "match": { "txId": "m3-c004", "id": "dsh-notes", "version": "0.1.0" } },
    { "event": "replay.rolled-back", "match": { "txId": "m3-c005", "id": "dsh-notes", "version": "0.1.0", "reason": "verify-failed" } },
    { "event": "replay.done", "match": { "committed": 1, "rolledBack": 1 } },
    { "event": "replay.receipt.asserted", "match": { "txId": "m3-c004", "status": "committed", "journalLines": 6 } },
    { "event": "replay.tree.intact", "match": { "verified": true } },
    { "event": "install.completed", "match": { "status": "pass", "committed": 2, "rejected": 1, "rolledBack": 1 } }
  ]
}
