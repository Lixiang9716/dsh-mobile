{
 "scenario": "office",
 "extract": {
  "prefix": "dsh.runtime.log:"
 },
 "expect": [
  {
   "event": "llm/runtime",
   "match": {
    "provider": "mock",
    "model": "mock-1",
    "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
    "transport": "gateway httpFetch → loopback chat-completions mock server",
    "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
   }
  },
  {
   "event": "upstream/profile",
   "match": {
    "profile": "mobile",
    "root": "empty (patch layers compose over it)",
    "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
    "layers": [
     "session",
     "agent",
     "system-prompt",
     "tools",
     "session-projection",
     "settings",
     "agent-loop"
    ]
   }
  },
  {
   "event": "upstream/services",
   "match": {
    "kernel": "@deepseek-ai/cordis@4.0.2",
    "services": [
     "sessions",
     "agents",
     "systemPrompt",
     "tools",
     "sessionProjections",
     "settings",
     "agentLoop",
     "llm"
    ],
    "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
   }
  },
  {
   "event": "session/created",
   "match": {
    "sessionId": "s-office-0001"
   }
  },
  {
   "event": "agent/created",
   "match": {
    "id": "main",
    "sessionId": "s-office-0001"
   }
  },
  {
   "event": "office/offered",
   "match": {
    "tools": 8
   }
  },
  {
   "event": "office.word/created",
   "match": {
    "path": "docs/demo.docx",
    "paragraphs": 3,
    "bullets": 3,
    "tableRows": 2
   }
  },
  {
   "event": "office.word/readMarkdown",
   "match": {
    "headings": 1,
    "bullets": 3,
    "tableRows": 2
   }
  },
  {
   "event": "office.word/appended",
   "match": {
    "paragraphs": 1,
    "verified": true
   }
  },
  {
   "event": "office.excel/created",
   "match": {
    "path": "sheets/demo.xlsx",
    "sheets": 1,
    "rows": 4
   }
  },
  {
   "event": "office.excel/readBack",
   "match": {
    "rows": 4,
    "cells": 12,
    "truncated": false
   }
  },
  {
   "event": "office.excel/updated",
   "match": {
    "cellWrites": 1,
    "value": "1.24"
   }
  },
  {
   "event": "office.ppt/created",
   "match": {
    "path": "decks/demo.pptx",
    "slides": 2,
    "canvas": "13.33x7.5"
   }
  },
  {
   "event": "office.ppt/readBack",
   "match": {
    "slides": 2,
    "elements": 4
   }
  },
  {
   "event": "office.fixture/docx",
   "match": {
    "chars": 95,
    "markdown": true
   }
  },
  {
   "event": "office.fixture/xlsx",
   "match": {
    "rows": 3,
    "sheet": "Data"
   }
  },
  {
   "event": "office.fixture/pptx",
   "match": {
    "slides": 2,
    "width": 13.33
   }
  },
  {
   "event": "office.negative/refused",
   "match": {
    "named": "overwrite"
   }
  },
  {
   "event": "upstream/completed",
   "match": {
    "status": "pass",
    "upstream": "0.1.6-alpha.2",
    "office": "system-plugins/dsh-office (dsh-office-tools surface over gateway fs)"
   }
  }
 ]
}
