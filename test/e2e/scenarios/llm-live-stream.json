{
  "scenario": "llm.live-stream",
  "extract": { "prefix": "dsh.spike.log:" },
  "expect": [
    { "event": "gateway.negotiated", "match": { "version": "gateway@1" } },
    { "event": "host.ready", "match": { "signalled": true } },
    { "event": "llm.leg", "match": { "leg": "scripted", "transport": "scripted-sse" } },
    { "event": "llm.config.loaded", "match": { "source": "scripted-fixture", "model": "scripted" } },
    { "event": "session.created", "match": { "sessionId": "s-llm-live-stream-0001", "scope": "app" } },
    { "event": "agent.started", "match": { "model": "scripted", "tools": 0 } },
    { "event": "llm.stream.started", "match": { "turn": 1 } },
    { "event": "llm.reasoning.delta", "match": { "index": 0, "text": "Pondering the greeting." } },
    { "event": "llm.delta", "match": { "index": 0, "text": "Hello" } },
    { "event": "llm.delta", "match": { "index": 1, "text": " from" } },
    { "event": "llm.delta", "match": { "index": 2, "text": " the" } },
    { "event": "llm.delta", "match": { "index": 3, "text": " real" } },
    { "event": "llm.delta", "match": { "index": 4, "text": " LLM" } },
    { "event": "llm.delta", "match": { "index": 5, "text": " backend." } },
    { "event": "llm.stream.completed", "match": { "turn": 1, "deltas": 6, "reasoningDeltas": 1, "chars": 32, "finishReason": "stop" } },
    { "event": "llm.served-model", "match": { "requested": "scripted", "served": "scripted-fixture" } },
    { "event": "llm.content.asserted", "match": { "text": "Hello from the real LLM backend.", "chars": 32 } },
    { "event": "llm.key.audit", "match": { "leaked": false } },
    { "event": "session.completed", "match": { "sessionId": "s-llm-live-stream-0001", "status": "pass", "deltas": 6, "chars": 32 } }
  ]
}
