{
  "scenario": "lynx.mount",
  "extract": { "prefix": "dsh.runtime.log:" },
  "expect": [
    { "event": "face.mounted", "match": { "face": "stub" } },
    { "event": "serve.listening", "match": { "loopback": true } },
    { "event": "connection.opened", "match": {} },
    { "event": "drawer.settled", "match": { "sessions": 1 } },
    { "event": "intent.observed", "match": { "type": "select-session" } },
    { "event": "session.selected", "match": { "sessionId": "s-dev-lynx-0000" } },
    { "event": "intent.observed", "match": { "type": "new-session" } },
    { "event": "session.created", "match": { "sessionId": "s-dev-lynx-0001" } },
    { "event": "intent.observed", "match": { "type": "submit" } },
    { "event": "prompt.submitted", "match": { "text": "画出极光" } },
    { "event": "prompt.admitted", "match": {} },
    { "event": "view.message.delta", "match": { "kind": "start" } },
    { "event": "view.message.delta", "match": { "kind": "reasoning" } },
    { "event": "view.tool.phase", "match": { "phase": "streaming" } },
    { "event": "view.tool.phase", "match": { "phase": "streaming" } },
    { "event": "view.message.delta", "match": { "kind": "text" } },
    { "event": "view.message.delta", "match": { "kind": "end" } },
    { "event": "view.tool.phase", "match": { "phase": "waiting" } },
    { "event": "view.tool.phase", "match": { "phase": "ok" } },
    { "event": "turn.settled", "match": { "tool": "bash · 完成", "creation": "桌面回声鲸鱼" } },
    { "event": "intent.observed", "match": { "type": "select-session" } },
    { "event": "view.tool.phase", "match": { "phase": "waiting" } },
    { "event": "view.tool.phase", "match": { "phase": "ok" } },
    { "event": "seed.replayed", "match": { "rebuilt": "mid-history, no blank mount" } },
    { "event": "intent.observed", "match": { "type": "submit" } },
    { "event": "view.message.delta", "match": { "kind": "start" } },
    { "event": "view.message.delta", "match": { "kind": "reasoning" } },
    { "event": "view.tool.phase", "match": { "phase": "streaming" } },
    { "event": "cancel.requested", "match": {} },
    { "event": "intent.observed", "match": { "type": "cancel" } },
    { "event": "cancel.settled", "match": { "status": "已停止", "tail": "dropped" } },
    { "event": "fail.loud.intent", "match": { "threw": true } },
    { "event": "fail.loud.view-event", "match": { "threw": true } },
    { "event": "loop.complete", "match": { "face": "stub", "status": "pass" } }
  ]
}
