{
  "scenario": "m3.fetch-carrier",
  "extract": { "prefix": "dsh.spike.log:" },
  "expect": [
    { "event": "config.resolved", "match": { "webClient": "dsh-web-client-mini", "slotSet": ["notes.toolbar"], "profile": "m3-complete", "format": "cordis.patch.json" } },
    { "event": "client.selected", "match": { "client": "dsh-web-client-mini", "source": "config" } },
    { "event": "webclient.mounted", "match": { "client": "dsh-web-client-mini", "path": "/index.html" } },
    { "event": "ws.connected", "match": { "protocol": "session-projection@0" } },
    { "event": "http.route-registered", "match": { "path": "/packages/dsh-notes-0.1.0.tar", "bytes": 3584 } },
    { "event": "http.served", "match": { "path": "/packages/dsh-notes-0.1.0.tar", "bytes": 3584 } },
    { "event": "slot.denied", "match": { "id": "debug.console", "set": ["notes.toolbar"] } },
    { "event": "slot.registered", "match": { "id": "notes.toolbar", "label": "notes", "by": "dsh-notes" } },
    { "event": "ws.token-delta", "match": { "first": true, "index": 0 } },
    { "event": "ws.token-delta", "match": { "last": true, "index": 4 } },
    { "event": "ws.session-complete", "match": { "status": "pass" } }
  ]
}
