{
 "scenario": "security.manifest-forgery",
 "extract": {
  "prefix": "dsh.runtime.log:"
 },
 "expect": [
  { "event": "forge.started", "match": { "pipeline": 5, "freshness": 1 } },
  { "event": "forge.case", "match": { "attack": "forge.capability.stale-manifest", "code": "integrity" } },
  { "event": "forge.case", "match": { "attack": "forge.capability.self-consistent", "code": "capability" } },
  { "event": "forge.case", "match": { "attack": "forge.entry-replaced", "code": "integrity" } },
  { "event": "forge.case", "match": { "attack": "forge.manifest-id-swap", "code": "manifest" } },
  { "event": "forge.case", "match": { "attack": "forge.version-rollback.pipeline", "code": "integrity" } },
  { "event": "forge.pipeline.rejected", "match": { "cases": 5 } },
  { "event": "forge.freshness.anchor", "match": { "anchored": "2026-10-01T00:00:00Z", "via": "first-contact" } },
  { "event": "forge.rollback.catalog", "match": { "outcome": "rejected", "code": "catalog", "via": "catalog-replay" } },
  { "event": "forge.freshness.honest-refresh", "match": { "generatedAt": "2026-10-01T00:00:00Z", "outcome": "accepted" } },
  { "event": "forge.survived", "match": { "installed": "dsh-echo@1.0.1" } },
  { "event": "forge.finding", "match": { "severity": "none", "outcome": "catalog-replay-rejected" } },
  { "event": "scenario.complete", "match": { "status": "pass" } }
 ]
}
