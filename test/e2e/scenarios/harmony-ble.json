{
  "scenario": "harmony.ble.plane",
  "extract": {
    "prefix": "dsh.spike.log:"
  },
  "expect": [
    {
      "event": "gateway.negotiated",
      "match": {
        "version": "gateway@1"
      }
    },
    {
      "event": "descriptor.declared",
      "match": {
        "available": 26,
        "unavailable": 2,
        "blePlane": 8
      }
    },
    {
      "event": "ble.radio",
      "match": {
        "mode": "absent"
      }
    },
    {
      "event": "ble.scan.unavailable",
      "match": {
        "code": "unavailable"
      }
    },
    {
      "event": "ble.stop.idempotent",
      "match": {
        "stopped": false
      }
    },
    {
      "event": "ble.connect.unavailable",
      "match": {
        "code": "unavailable"
      }
    },
    {
      "event": "ble.disconnect.idempotent",
      "match": {
        "closed": false
      }
    },
    {
      "event": "scenario.complete",
      "match": {
        "status": "pass"
      }
    }
  ]
}
