{
  "scenario": "mic.plane",
  "extract": {
    "prefix": "dsh.spike.log:"
  },
  "expect": [
    {
      "event": "gateway.negotiated",
      "match": {
        "version": "gateway@1"
      }
    },
    {
      "event": "descriptor.declared",
      "match": {
        "available": 18,
        "unavailable": 2,
        "micPlane": 2
      }
    },
    {
      "event": "mic.armed",
      "match": {
        "format": "pcm-s16le"
      }
    },
    {
      "event": "mic.frames",
      "match": {
        "consumed": true,
        "monotonic": true,
        "samples": true
      }
    },
    {
      "event": "mic.stopped",
      "match": {
        "stopped": true,
        "duration": true,
        "bytes": true
      }
    },
    {
      "event": "mic.end",
      "match": {
        "reason": "stopped"
      }
    },
    {
      "event": "mic.stop.idempotent",
      "match": {
        "stopped": false
      }
    },
    {
      "event": "mic.stop.unknown",
      "match": {
        "stopped": false
      }
    },
    {
      "event": "scenario.complete",
      "match": {
        "status": "pass"
      }
    }
  ]
}
