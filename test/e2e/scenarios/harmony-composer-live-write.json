{
  "scenario": "harmony.composer.live-write",
  "extract": {
    "prefix": "dsh.runtime.log:"
  },
  "expect": [
    {
      "event": "client.selected",
      "match": {
        "client": "dsh-web-official",
        "source": "launch"
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
        "transport": "gateway httpFetch → carrier scripted chat-completions (E2E determinism boundary, mirrors the CLI mock server)",
        "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile",
        "root": "empty (patch layers compose over it)",
        "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
        "layers": [
          "session",
          "agent",
          "system-prompt",
          "tools",
          "session-projection",
          "settings",
          "agent-loop"
        ]
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2",
        "services": [
          "sessions",
          "agents",
          "systemPrompt",
          "tools",
          "sessionProjections",
          "settings",
          "agentLoop",
          "llm"
        ],
        "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
      }
    },
    {
      "event": "session/created",
      "match": {
        "sessionId": "s-harmony-write-0001"
      }
    },
    {
      "event": "agent/created",
      "match": {
        "id": "main",
        "sessionId": "s-harmony-write-0001"
      }
    },
    {
      "event": "web.boot.applied",
      "match": {
        "rows": 6,
        "source": "runtime (spine + vendored @deepseek-ai/dsh-client-modules)"
      }
    },
    {
      "event": "runtime.booted",
      "match": {
        "entries": 58,
        "source": "vendored @deepseek-ai/dsh-client-modules composed in-runtime"
      }
    },
    {
      "event": "spine.tools.mounted",
      "match": {
        "count": 16,
        "source": "ctx.tools.view (the registry visibility view)"
      },
      "note": "T-0048 tail item, log-asserted: the session toolset this user-facing boot serves. The 16 mounted tools are the spine/system-plugin face (fs/edit/shell/web_search/plugin_manager/office plane/todo); the bash/pwsh/present/ralph preset rows are NOT in the set — they are preset-document rows, and the boot agent joins no preset (upstream/boot.js staged gap) until the preset-join work lands. Staged + preset-resolvable is the state; mounted-in-boot is not, and this record keeps that truth on the log."
    },
    {
      "event": "write.surface.claimed",
      "match": {
        "streams": [
          "session/follow",
          "workspace/follow",
          "session/control",
          "$events"
        ],
        "source": "the on-device spine (ctx.sessions/agents/settings)",
        "endpointCount": 38
      }
    },
    {
      "event": "index.injected",
      "match": {
        "rows": 6,
        "bytes": 31304
      }
    },
    {
      "event": "index.served",
      "match": {
        "path": "/",
        "status": 200
      }
    },
    {
      "event": "upgrade.accepted",
      "match": {
        "path": "/api/remote.mux"
      }
    },
    {
      "event": "mux.upgraded",
      "match": {
        "path": "/api/remote.mux"
      }
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "settings/describe",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "dynamicCordisRunner/syncInspectManifest",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "dynamicCordisRunner/inventory",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "credentials/describe",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "session/modelCatalog",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "session.attached",
      "match": {
        "stream": "workspace/follow"
      },
      "order": "any"
    },
    {
      "event": "journal.frame.forwarded",
      "match": {
        "direction": "tx",
        "first": true,
        "source": "REAL follow feeds (snapshot/baseline + live turn frames)"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "agentPresets/list",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "session/create",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "subagents/list",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "skills/list",
        "answered": "unavailable"
      },
      "note": "the catalog probe fires ONE of {skills/list, commands/list} per boot (the \"/\" palette's last-viewed state) — optional rows in position pin whichever fired; the structured unavailable IS the honest answer (the write leg's runtime.config carries no skills option, so the catalog plane does not join)",
      "optional": true,
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "commands/list",
        "answered": "unavailable"
      },
      "optional": true,
      "order": "any"
    },
    {
      "event": "workspace.picked",
      "match": {
        "chip": true,
        "composer": true
      }
    },
    {
      "event": "composer.typed",
      "match": {
        "found": "div",
        "editable": true,
        "value": "Say hello from the composer",
        "text": "Say hello from the composer"
      }
    },
    {
      "event": "write.prompt.observed",
      "match": {
        "seq": 5
      }
    },
    {
      "event": "llm/request/built",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "messages": 2,
        "tools": 16,
        "path": "/chat/completions",
        "method": "POST",
        "agentLoopMarked": true,
        "stream": true
      }
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "session/prompt",
        "answered": "forwarded"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "Hello"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": " from"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": " upst"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "ream"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "finish": "stop",
        "usage": {
          "inputTokens": 3,
          "outputTokens": 19,
          "totalTokens": 22
        }
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "done": true
      }
    },
    {
      "event": "write.turn.settled",
      "match": {
        "events": 11,
        "text": "Hello from upstream"
      }
    },
    {
      "event": "write.follow.frames",
      "match": {
        "frames": 1,
        "shapes": [
          "snapshot:10"
        ]
      }
    },
    {
      "event": "write.reply.rendered",
      "match": {
        "reply": "Hello from upstream",
        "userText": "Say hello from the composer",
        "moduleMode": "live"
      }
    },
    {
      "event": "write.live.complete",
      "match": {
        "status": "pass"
      }
    }
  ]
}
