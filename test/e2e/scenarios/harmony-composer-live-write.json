{
  "scenario": "harmony.composer.live-write",
  "extract": {
    "prefix": "dsh.runtime.log:"
  },
  "expect": [
    {
      "event": "client.selected",
      "match": {
        "client": "dsh-web-official",
        "source": "launch"
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
        "transport": "gateway httpFetch → carrier scripted chat-completions (E2E determinism boundary, mirrors the CLI mock server)",
        "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile",
        "root": "empty (patch layers compose over it)",
        "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
        "layers": [
          "session",
          "agent",
          "system-prompt",
          "tools",
          "session-projection",
          "settings",
          "agent-loop"
        ]
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2",
        "services": [
          "sessions",
          "agents",
          "systemPrompt",
          "tools",
          "sessionProjections",
          "settings",
          "agentLoop",
          "llm"
        ],
        "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
      }
    },
    {
      "event": "session/created",
      "match": {
        "sessionId": "s-harmony-write-0001"
      }
    },
    {
      "event": "agent/created",
      "match": {
        "id": "main",
        "sessionId": "s-harmony-write-0001"
      }
    },
    {
      "event": "web.boot.applied",
      "match": {
        "rows": 6,
        "source": "runtime (spine + vendored @deepseek-ai/dsh-client-modules)"
      }
    },
    {
      "event": "runtime.booted",
      "match": {
        "entries": 58,
        "source": "vendored @deepseek-ai/dsh-client-modules composed in-runtime"
      }
    },
    {
      "event": "spine.tools.mounted",
      "match": {
        "tools": [
          "ask_user_question",
          "bash",
          "create_goal",
          "edit",
          "excel_create",
          "excel_read",
          "excel_update",
          "exit_plan_mode",
          "get_goal",
          "interrupt_agent",
          "job_kill",
          "job_list",
          "job_output",
          "list_agents",
          "plugin_manager",
          "ppt_create",
          "ppt_read",
          "present",
          "read",
          "send_message",
          "shell",
          "skill",
          "str_replace_editor",
          "todo_write",
          "update_goal",
          "web_search",
          "word_create",
          "word_read",
          "word_update",
          "write"
        ],
        "count": 30,
        "source": "ctx.tools.view(agent) — the mobile-joined session toolset (the registry visibility view)"
      },
      "order": "any",
      "note": "T-0048 tail item, log-asserted: the session toolset the joined user-facing boot serves. The boot agent joins the deployment default preset (mobile — AgentPresets.mount at the seat's presetJoin flag, deferred to the page's first delivery: the join's compose runs on the host's UI thread and would starve the origin open's nweb creation), so the view resolves through the agent's scope: the 16 spine/system-plugin tools PLUS the composition's rows — bash and present mount visible; ask_user_question/goal/plan-mode/jobs/skill join from their composition rows. pwsh and ralph are NOT in the set: pwsh is platform-gated (win32-only — no PowerShell exists on the device) and ralph is upstream default-off; both ride the LIVE composition with their gates (spine.preset.joined carries the per-row truth), and tool-workflow is seed-disabled (its engine rides the walled PTC host runner). The subagent pair registers when the spawn provider lands (post-join), so they are not in this snapshot."
    },
    {
      "event": "spine.preset.joined",
      "match": {
        "preset": "mobile",
        "agent": "s-harmony-write-0001",
        "rows": [
          {
            "module": "@deepseek-ai/dsh-tool-bash",
            "enabled": true,
            "condition": "process.platform === 'win32'"
          },
          {
            "module": "@deepseek-ai/dsh-tool-pwsh",
            "enabled": false,
            "condition": "process.platform !== 'win32'"
          },
          {
            "module": "@deepseek-ai/dsh-tool-present",
            "enabled": true
          },
          {
            "module": "@deepseek-ai/dsh-tool-ralph",
            "enabled": false
          }
        ],
        "source": "AgentPresets.mount (the deployment default; the seat presetJoin flag)"
      },
      "order": "any",
      "note": "T-0048 tail item: the standing mount composed LIVE on-device — each of the four roster rows carries its honest state out of the joined composition (bash/present enabled, pwsh's platform gate and ralph's default-off gate), each package resolving through its agentPresets.seed node_modules marker onto the staged vendored face."
    },
    {
      "event": "write.surface.claimed",
      "match": {
        "streams": [
          "session/follow",
          "workspace/follow",
          "session/control",
          "$events"
        ],
        "source": "the on-device spine (ctx.sessions/agents/settings)",
        "endpointCount": 38
      }
    },
    {
      "event": "index.injected",
      "match": {
        "rows": 6,
        "bytes": 31304
      }
    },
    {
      "event": "index.served",
      "match": {
        "path": "/",
        "status": 200
      }
    },
    {
      "event": "upgrade.accepted",
      "match": {
        "path": "/api/remote.mux"
      }
    },
    {
      "event": "mux.upgraded",
      "match": {
        "path": "/api/remote.mux"
      }
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "settings/describe",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "dynamicCordisRunner/syncInspectManifest",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "dynamicCordisRunner/inventory",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "credentials/describe",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "session/modelCatalog",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "session.attached",
      "match": {
        "stream": "workspace/follow"
      },
      "order": "any"
    },
    {
      "event": "journal.frame.forwarded",
      "match": {
        "direction": "tx",
        "first": true,
        "source": "REAL follow feeds (snapshot/baseline + live turn frames)"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "agentPresets/list",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "session/create",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "subagents/list",
        "answered": "forwarded"
      },
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "skills/list",
        "answered": "unavailable"
      },
      "note": "the catalog probe fires ONE of {skills/list, commands/list} per boot (the \"/\" palette's last-viewed state) — optional rows in position pin whichever fired; the structured unavailable IS the honest answer (the write leg's runtime.config carries no skills option, so the catalog plane does not join)",
      "optional": true,
      "order": "any"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "commands/list",
        "answered": "unavailable"
      },
      "optional": true,
      "order": "any"
    },
    {
      "event": "workspace.picked",
      "match": {
        "chip": true,
        "composer": true
      }
    },
    {
      "event": "composer.typed",
      "match": {
        "found": "div",
        "editable": true,
        "value": "Say hello from the composer",
        "text": "Say hello from the composer"
      }
    },
    {
      "event": "write.prompt.observed",
      "match": {
        "seq": 5
      }
    },
    {
      "event": "llm/request/built",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "messages": 2,
        "tools": 30,
        "path": "/chat/completions",
        "method": "POST",
        "agentLoopMarked": true,
        "stream": true
      },
      "note": "the page session joins the deployment default at create (the write surface presetJoin) — the turn serves the joined composition"
    },
    {
      "event": "rpc.observed",
      "match": {
        "endpoint": "session/prompt",
        "answered": "forwarded"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "Hello"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": " from"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": " upst"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "ream"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "finish": "stop",
        "usage": {
          "inputTokens": 3,
          "outputTokens": 19,
          "totalTokens": 22
        }
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "done": true
      }
    },
    {
      "event": "write.turn.settled",
      "match": {
        "events": 11,
        "text": "Hello from upstream"
      }
    },
    {
      "event": "write.follow.frames",
      "match": {
        "frames": 1,
        "shapes": [
          "snapshot:10"
        ]
      }
    },
    {
      "event": "write.reply.rendered",
      "match": {
        "reply": "Hello from upstream",
        "userText": "Say hello from the composer",
        "moduleMode": "live"
      }
    },
    {
      "event": "write.live.complete",
      "match": {
        "status": "pass"
      }
    }
  ]
}
