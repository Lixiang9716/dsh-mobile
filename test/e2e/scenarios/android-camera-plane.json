{
  "scenario": "camera.plane",
  "extract": {
    "prefix": "dsh.runtime.log:"
  },
  "expect": [
    {
      "event": "gateway.negotiated",
      "match": {
        "version": "gateway@1"
      }
    },
    {
      "event": "descriptor.camera",
      "match": {
        "capture": true,
        "phased": 2
      }
    },
    {
      "event": "record.unavailable",
      "match": {
        "code": "unavailable"
      }
    },
    {
      "event": "record.stop.unavailable",
      "match": {
        "code": "unavailable"
      }
    },
    {
      "event": "capture.burst",
      "match": {
        "count": 2,
        "formatOk": true,
        "sizedOk": true,
        "stampedOk": true
      }
    },
    {
      "event": "capture.readback",
      "match": {
        "frames": 2,
        "matched": true
      }
    },
    {
      "event": "capture.maxbytes",
      "match": {
        "photos": 0,
        "dropped": true
      }
    },
    {
      "event": "scenario.complete",
      "match": {
        "status": "pass"
      }
    }
  ]
}
