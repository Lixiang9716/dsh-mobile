{
 "scenario": "plugin.forms",
 "extract": {
  "prefix": "dsh.runtime.log:"
 },
 "expect": [
  {
   "event": "spine.booted",
   "match": {
    "sessionId": "s-plugin-forms-0001"
   }
  },
  {
   "event": "authored.trees",
   "match": {
    "specs": [
     "forms-hello",
     "forms-fn",
     "forms-service"
    ]
   }
  },
  {
   "event": "form.mounted",
   "match": {
    "spec": "forms-hello"
   }
  },
  {
   "event": "form.mounted",
   "match": {
    "spec": "forms-fn"
   }
  },
  {
   "event": "form.mounted",
   "match": {
    "spec": "forms-service"
   }
  },
  {
   "event": "forms.live",
   "match": {
    "object": true,
    "function": true,
    "service": true
   }
  },
  {
   "event": "config.validated",
   "match": {
    "greeting": "Hola"
   }
  },
  {
   "event": "config.updated",
   "match": {
    "greeting": "Bonjour"
   }
  },
  {
   "event": "config.update-invalid",
   "match": {
    "refused": true
   }
  },
  {
   "event": "config.default",
   "match": {
    "greeting": "Hello"
   }
  },
  {
   "event": "config.invalid",
   "match": {
    "refused": true
   }
  },
  {
   "event": "events.observed",
   "match": {
    "on": 1,
    "bail": "blocked",
    "wf": "hey!",
    "serial": "serial-answer",
    "parallel": 1,
    "order": "head:x-tail"
   }
  },
  {
   "event": "events.detached",
   "match": {
    "on": 1
   }
  },
  {
   "event": "policy.denied",
   "match": {
    "denied": true
   }
  },
  {
   "event": "tool.greeted",
   "match": {
    "policed": true,
    "guarded": true,
    "rewritten": 1,
    "blocked": 1
   }
  },
  {
   "event": "jobs.lifecycle",
   "match": {
    "completed": "bash-1",
    "killed": "bash-2"
   }
  },
  {
   "event": "nested.provided",
   "match": {
    "child": true,
    "provide": true
   }
  },
  {
   "event": "cascade.disposed",
   "match": {
    "alive": false
   }
  },
  {
   "event": "cascade.reloaded",
   "match": {
    "alive": true
   }
  },
  {
   "event": "nested.recursive",
   "match": {
    "child": false
   }
  },
  {
   "event": "pending.refused",
   "match": {
    "step": "mounted"
   }
  },
  {
   "event": "llm.streamed",
   "match": {
    "text": "forms-llm-echo",
    "stop": "stop"
   }
  },
  {
   "event": "form.unmounted",
   "match": {
    "spec": "forms-hello"
   }
  },
  {
   "event": "form.unmounted",
   "match": {
    "spec": "forms-fn"
   }
  },
  {
   "event": "form.unmounted",
   "match": {
    "spec": "forms-service"
   }
  },
  {
   "event": "unload.effects",
   "match": {
    "disposed": 1
   }
  },
  {
   "event": "reload.edited",
   "match": {
    "loaded": 2
   }
  },
  {
   "event": "bootlist.mounted",
   "match": {
    "spec": "forms-boot",
    "skipped": "forms-hello(disabled)"
   }
  },
  {
   "event": "scenario.complete",
   "match": {
    "status": "pass"
   }
  }
 ]
}
