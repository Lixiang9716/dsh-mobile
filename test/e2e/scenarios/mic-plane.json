{
  "scenario": "mic.plane",
  "extract": {
    "prefix": "dsh.spike.log:"
  },
  "expect": [
    {
      "event": "gateway.negotiated",
      "match": {
        "version": "gateway@1"
      }
    },
    {
      "event": "descriptor.declared",
      "match": {
        "available": 24,
        "unavailable": 0,
        "micPlane": 2
      }
    },
    {
      "event": "mic.refused",
      "match": {
        "resolved": "unavailable"
      }
    },
    {
      "event": "mic.stop.unknown",
      "match": {
        "stopped": false
      }
    },
    {
      "event": "scenario.complete",
      "match": {
        "status": "pass"
      }
    }
  ]
}
