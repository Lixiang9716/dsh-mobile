{
  "scenario": "install.from-http",
  "extract": { "prefix": "dsh.spike.log:" },
  "expect": [
    { "event": "gateway.negotiated", "match": { "version": "gateway@1" } },
    { "event": "fs.ready", "match": { "service": "fs" } },
    { "event": "carrier.ready", "match": { "source": "carrier.info" } },
    { "event": "fixture.built", "match": { "members": 2, "bytes": 3584 } },
    { "event": "install.fetch.start", "match": {} },
    { "event": "install.fetch.status", "match": { "status": 200 } },
    { "event": "install.fetch.body", "match": { "bytes": 3584 } },
    { "event": "install.blob.stored", "match": { "sha256": "eb478c292d671deac3617f2759a0a44293cbf292b17b0233677aa3a871b4dd56", "bytes": 3584 } },
    { "event": "install.digest.verified", "match": { "sha256": "eb478c292d671deac3617f2759a0a44293cbf292b17b0233677aa3a871b4dd56" } },
    { "event": "install.manifest.validated", "match": { "id": "dsh-notes", "version": "0.1.0" } },
    { "event": "install.integrity.computed", "match": { "files": 2, "manifestSha256": "26d16425d35d55800325345d53375ace7a9f8f1d3f794fb5b71ae62d6ae99358" } },
    { "event": "install.negotiated", "match": { "required": 2, "skipped": false } },
    { "event": "install.receipt.pending", "match": { "txId": "m3-f001", "journal": "receipts/journal.jsonl" } },
    { "event": "install.staged.verified", "match": { "files": 3 } },
    { "event": "install.promoted", "match": { "dir": "plugins/dsh-notes@0.1.0", "files": 3 } },
    { "event": "install.committed", "match": { "status": "committed", "previousVersion": null, "treeSha256": "a7c1a54bab6caa41055a0d7b4086d6e41ecf7cb74c846490304d87ddeda51a4d" } },
    { "event": "install.receipt.asserted", "match": { "status": "committed", "id": "dsh-notes", "version": "0.1.0", "blobSha256": "eb478c292d671deac3617f2759a0a44293cbf292b17b0233677aa3a871b4dd56", "journalLines": 2 } },
    { "event": "installed.loaded", "match": { "id": "dsh-notes", "moduleId": "plugins/dsh-notes@0.1.0/bundle/index.js" } },
    { "event": "crash.simulated", "match": { "txId": "m3-f002", "mode": "staged-verifies", "files": 2 } },
    { "event": "crash.simulated", "match": { "txId": "m3-f003", "mode": "staging-incomplete", "files": 1 } },
    { "event": "replay.begin", "match": { "pending": 2 } },
    { "event": "replay.committed", "match": { "txId": "m3-f002", "id": "dsh-notes", "version": "0.1.0" } },
    { "event": "replay.rolled-back", "match": { "txId": "m3-f003", "id": "dsh-notes", "version": "0.1.0", "reason": "verify-failed" } },
    { "event": "replay.done", "match": { "committed": 1, "rolledBack": 1 } },
    { "event": "replay.receipt.asserted", "match": { "txId": "m3-f002", "status": "committed", "journalLines": 6 } },
    { "event": "replay.tree.intact", "match": { "verified": true } },
    { "event": "host.ready", "match": { "signalled": true } },
    { "event": "session.created", "match": { "sessionId": "s-m3-0001", "scope": "app" } },
    { "event": "agent.started", "match": { "model": "mock-mini", "tools": 1 } },
    { "event": "llm.stream.started", "match": { "turn": 1 } },
    { "event": "llm.delta", "match": { "index": 0, "text": "Hello" } },
    { "event": "llm.delta", "match": { "index": 1, "text": " from" } },
    { "event": "llm.delta", "match": { "index": 2, "text": " DSH" } },
    { "event": "llm.stream.completed", "match": { "turn": 1, "deltas": 3, "toolCalls": 1 } },
    { "event": "tool.invoked", "match": { "name": "notes.persist", "call": "t-1" } },
    { "event": "subprocess.spawned", "match": { "taskId": "task-1", "steps": 2 } },
    { "event": "subprocess.progress", "match": { "taskId": "task-1", "step": 1 } },
    { "event": "subprocess.progress", "match": { "taskId": "task-1", "step": 2 } },
    { "event": "fs.write.ok", "match": { "written": 33, "path": "install-from-http/result.txt" } },
    { "event": "subprocess.completed", "match": { "taskId": "task-1", "ok": true } },
    { "event": "tool.result", "match": { "name": "notes.persist", "call": "t-1", "ok": true } },
    { "event": "llm.stream.started", "match": { "turn": 2 } },
    { "event": "llm.delta", "match": { "index": 3, "text": " Saved" } },
    { "event": "llm.delta", "match": { "index": 4, "text": " ok" } },
    { "event": "llm.stream.completed", "match": { "turn": 2, "deltas": 2, "toolCalls": 0 } },
    { "event": "session.completed", "match": { "sessionId": "s-m3-0001", "status": "pass", "deltas": 5, "toolCalls": 1, "persisted": true } }
  ]
}
