# Logto deployment placeholders — copy to `.env` ON THE DEPLOYMENT HOST.
#   cp logto/env.example .env && chmod 600 .env
# NEVER commit `.env`, and never paste real values into git, chat, or a
# ticket. The repository ships placeholders only (CHANGE_ME markers).

# Postgres password — GENERATE IT ON THE HOST, never here. HEX ONLY:
# base64's '/' would corrupt the postgresql:// URL in docker-compose.yml.
#   openssl rand -hex 24
# (deploy.sh generates exactly this form via od when .env is absent.)
POSTGRES_PASSWORD=CHANGE_ME_ON_HOST

POSTGRES_DB=logto

# Issuer + admin console URLs (callback-domain placeholders — replace
# CHANGE_ME with the domains YOU own; both need DNS + TLS via the
# reverse proxy, see README "HTTPS"):
ENDPOINT=https://idp.CHANGE_ME.example.com
ADMIN_ENDPOINT=https://idp-admin.CHANGE_ME.example.com
