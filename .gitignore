# macOS
.DS_Store

# Node
node_modules/
package-lock.json

# 构建产物
dist/
build/
out/

# W-SHELL application-tier client bundles — built output of the pinned
# upstream client face (presentation/official-web/client-bundles/
# build-client-bundles.sh), untracked like the official dist so the content
# gates never judge verbatim upstream JS; the tracked provenance record is
# the directory's MANIFEST.sha256 + ROSTER.json + PROVENANCE.md, and
# tools/e2e/ensure-client-bundles.sh materializes + verifies the tree.
presentation/official-web/client-bundles/npm/

# iOS / Xcode
hosts/ios/**/*.xcuserstate
hosts/ios/**/xcuserdata/
hosts/ios/Pods/
hosts/ios/DerivedData/

# Android / 鸿蒙（预留）
hosts/android/.gradle/
hosts/android/app/build/
hosts/harmony/.preview/
hosts/harmony/build/

# 环境 / 密钥 —— 任何 token、密钥不入库
.env
.env.*
*.local
*.pem
*.mobileprovision

# 日志 / 临时
*.log
tmp/
.cache/

# govrail 运行账本（本地趋势数据，不入库）
.gov/history/

# vendored engine sources + vendored upstream DSH runtime packages — pinned
# + sha256-verified by runtime/spike/vendor/ensure.sh and ensure-dsh.sh;
# untracked so the syntax-class checker never judges upstream C or the
# verbatim upstream JS bundles (adaptation lives in our shims, never in the
# vendored copies — D6/D9; the pin tables in the ensure scripts are the
# tracked provenance record)
runtime/spike/vendor/quickjs-ng/
runtime/spike/vendor/dsh/
runtime/spike/vendor/npm/

# Python
__pycache__/
.gov/tasks/.new.lock
runtime/spike/logs-upstream.txt
runtime/spike/logs-upstream-boot.txt
