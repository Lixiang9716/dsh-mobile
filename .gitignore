package-lock.json

# 构建产物
dist/
build/
out/

# W-SHELL application-tier client bundles — built output of the pinned
# upstream client face (presentation/official-web/client-bundles/
# build-client-bundles.sh), untracked like the official dist so the content
# gates never judge verbatim upstream JS; the tracked provenance record is
# the directory's MANIFEST.sha256 + ROSTER.json + PROVENANCE.md, and
# tools/e2e/ensure-client-bundles.sh materializes + verifies the tree.
presentation/official-web/client-bundles/npm/

# D9 W-HARMONY official-web mount assets, copied VERBATIM into the app
# rawfile by hosts/harmony/ci/vendor-official.sh (dist + staged client
# bundles; the web-boot closure it also copies IS committed — those files
# are ours or gate-excluded /vendor/). Untracked for the same reason as the
# client-bundles above: the content gates must never judge bundled upstream
# JS (the iOS surprise ledger: 5087 violations); the vendor script is the
# materialize + cmp-verify step and runs inside run-host-e2e.sh's build.
hosts/harmony/entry/src/main/resources/rawfile/spike/officialweb/

